<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DnsAi.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="760"
        x:Class="DnsAi.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="DNS-AI — Клиент шифрованного DNS"
        Icon="/Assets/icon.ico"
        Width="680" Height="780"
        MinWidth="540" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto" Margin="24">
            
            <!-- 1. Header: Logo, Title, Admin Badge -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#2980B9">
                        <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DNS-AI" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Шифрованный DNS для Windows" FontSize="12" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" 
                        Background="#27AE60" 
                        CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="Режим администратора" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </Border>
            </Grid>

            <!-- 2. Hero Card: Status & Big Toggle -->
            <Border Grid.Row="1" CornerRadius="16" Background="#1E232A" Padding="20" Margin="0,0,0,14" BoxShadow="0 4 16 #20000000">
                <Grid ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="12" Height="12" Fill="{Binding StatusBadgeColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusTitle}" FontSize="18" FontWeight="Bold" Foreground="White" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusSubtitle}" FontSize="13" Foreground="#BDC3C7" TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch Grid.Column="1" 
                                  IsChecked="{Binding IsActive, Mode=OneWay}" 
                                  Command="{Binding ToggleProtectionCommand}"
                                  IsEnabled="{Binding !IsBusy}"
                                  OnContent="ВКЛ" OffContent="ВЫКЛ"
                                  VerticalAlignment="Center"
                                  Margin="12,0,0,0" />
                </Grid>
            </Border>

            <!-- 3. Metrics Cards -->
            <Grid Grid.Row="2" ColumnDefinitions="*, *, *" Margin="0,0,0,14">
                <!-- Ping / Latency -->
                <Border Grid.Column="0" CornerRadius="12" Background="#181C22" Padding="12" Margin="0,0,5,0">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Задержка (Пинг)" FontSize="11" Foreground="#95A5A6" />
                        <TextBlock Text="{Binding LatencyText}" FontSize="16" FontWeight="Bold" Foreground="#3498DB" />
                    </StackPanel>
                </Border>

                <!-- Queries Processed -->
                <Border Grid.Column="1" CornerRadius="12" Background="#181C22" Padding="12" Margin="3,0,3,0">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Запросов DoH" FontSize="11" Foreground="#95A5A6" />
                        <TextBlock Text="{Binding QueriesText}" FontSize="16" FontWeight="Bold" Foreground="#2ECC71" />
                    </StackPanel>
                </Border>

                <!-- Active Node -->
                <Border Grid.Column="2" CornerRadius="12" Background="#181C22" Padding="12" Margin="5,0,0,0">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Узел DoH" FontSize="11" Foreground="#95A5A6" />
                        <TextBlock Text="{Binding ActiveNodeText}" FontSize="12" FontWeight="SemiBold" Foreground="#E67E22" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Settings Card (Mode, Autostart, VPN) -->
            <Border Grid.Row="3" CornerRadius="14" Background="#181C22" Padding="16" Margin="0,0,0,14">
                <StackPanel Spacing="12">
                    <TextBlock Text="⚙️ Настройки" FontSize="14" FontWeight="Bold" Foreground="White" />
                    
                    <!-- Mode Selection -->
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Режим шифрования" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                            <TextBlock Text="Локальный stub-прокси или встроенный DoH клиент Windows 11" FontSize="11" Foreground="#7F8C8D" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" 
                                  SelectedIndex="{Binding SelectedModeIndex}" 
                                  IsEnabled="{Binding !IsActive}"
                                  FontSize="12">
                            <ComboBoxItem Content="Локальный резолвер (127.0.0.1)" />
                            <ComboBoxItem Content="Нативный DoH (Windows 11)" IsEnabled="{Binding IsWindows11}" />
                        </ComboBox>
                    </Grid>

                    <Separator Background="#2C3E50" Height="1" />

                    <!-- Autostart & VPN Toggles -->
                    <Grid ColumnDefinitions="*, *">
                        <Grid Grid.Column="0" ColumnDefinitions="*, Auto" Margin="0,0,10,0">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Автозапуск" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Запуск при входе" FontSize="11" Foreground="#7F8C8D" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" 
                                          IsChecked="{Binding IsAutostartEnabled, Mode=TwoWay}"
                                          OnContent="" OffContent="" />
                        </Grid>

                        <Grid Grid.Column="1" ColumnDefinitions="*, Auto" Margin="10,0,0,0">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="VPN-адаптеры" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Настраивать туннели" FontSize="11" Foreground="#7F8C8D" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" 
                                          IsChecked="{Binding IncludeVpnAdapters, Mode=TwoWay}"
                                          IsEnabled="{Binding !IsActive}"
                                          OnContent="" OffContent="" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. Network Adapters List with Checkboxes -->
            <Border Grid.Row="4" CornerRadius="14" Background="#181C22" Padding="16" MinHeight="180">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Сетевые адаптеры" FontSize="14" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="(выберите для защиты)" FontSize="12" Foreground="#7F8C8D" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="🔄 Обновить" Command="{Binding RefreshAdaptersCommand}" FontSize="11" Padding="8,4" CornerRadius="6" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" MaxHeight="220">
                        <ItemsControl ItemsSource="{Binding Adapters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Background="#21262F" Padding="10,8" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                                            <!-- Checkbox for individual selection -->
                                            <CheckBox Grid.Column="0" 
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                      IsEnabled="{Binding CanSelect}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0" />

                                            <TextBlock Grid.Column="1" Text="🌐" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#7F8C8D" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Border Grid.Column="3" CornerRadius="6" Background="#2C3E50" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayStatus}" FontSize="11" Foreground="#ECF0F1" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 6. Footer: Actions & Status message -->
            <Grid Grid.Row="5" ColumnDefinitions="*, Auto" Margin="0,14,0,0">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="#95A5A6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Очистить кэш DNS" Command="{Binding FlushDnsCommand}" FontSize="12" Padding="12,6" CornerRadius="6" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
